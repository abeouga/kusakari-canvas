{
  "name": "kusakari-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:web": "npm --workspace frontend run dev",
    "dev:api": "node scripts/api.mjs dev",
    "migrate:api": "node scripts/api.mjs migrate",
    "verify:api": "node scripts/api.mjs verify",
    "lint:api": "node scripts/api.mjs lint",
    "precheck": "npm run lint && npm run lint:api && npm run compile:api",
    "lint": "eslint frontend/src e2e scripts playwright.config.ts",
    "compile:api": "node scripts/api.mjs compile",
    "build:web": "npm --workspace frontend run build",
    "test:e2e": "node scripts/e2e.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:plant-parts": "node scripts/generate-plant-parts.mjs",
    "assets:plant-parts:v2": "node scripts/generate-plant-parts-v2.mjs",
    "verify:plant-parts:v2": "node scripts/verify-plant-parts-v2.mjs",
    "test:plant-library": "playwright test --config playwright.plant-library.config.ts",
    "test:plant-model": "playwright test --config playwright.plant-model.config.ts",
    "test:ai-products": "playwright test --config playwright.ai-products.config.ts",
    "test:shopping": "playwright test --config playwright.shopping.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
  	"@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
