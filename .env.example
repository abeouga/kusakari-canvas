# Copy this file to .env and set the password locally.
KUSAKARI_CANVAS_DB_USER=kusakari_canvas_dev
KUSAKARI_CANVAS_DB_PASSWORD=
# Optional. Existing jdbc:mysql:// URLs without query parameters are also accepted.
# KUSAKARI_CANVAS_DB_URL=mysql://127.0.0.1:3306/kusakari_canvas
# E2E uses only KUSAKARI_CANVAS_E2E_DB_* environment variables or the ignored .env.e2e file.
# KUSAKARI_CANVAS_E2E_DB_USER=kusakari_canvas_e2e
# KUSAKARI_CANVAS_E2E_DB_PASSWORD=
# KUSAKARI_CANVAS_E2E_DB_URL=mysql://127.0.0.1:3306/kusakari_canvas_e2e
# Optional local data root override; defaults to the current user's platform data folder.
# KUSAKARI_CANVAS_HOME=

# EC entry and material-candidate screen
VITE_KUSAKARI_EC_URL=http://127.0.0.1:5186/

# AI completion image: fresh local development key (never commit a real key).
OPENAI_API_KEY=
KUSAKARI_CANVAS_EC_URL=http://127.0.0.1:5186/
# E2E never reads OPENAI_API_KEY or the development .env for AI configuration.
# Put only dedicated E2E settings in .env.e2e or explicit environment variables.
# KUSAKARI_CANVAS_E2E_OPENAI_API_KEY=
# KUSAKARI_CANVAS_E2E_EC_URL=http://127.0.0.1:5187/
# Shared EC/Cognito server session (requires the EC cognito profile and a real User Pool).
# Public values: config/cognito.development.json. Apply from EC with scripts/configure-cognito.mjs.
# Full instructions: docs/cognito-setup.md. Keep database passwords and API keys in this local file only.
# Normal startup requires the EC authenticated session.
KUSAKARI_AUTH_MODE=cognito
# KUSAKARI_CANVAS_AUTH_EC_URL=http://127.0.0.1:8086
